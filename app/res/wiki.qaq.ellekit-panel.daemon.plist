<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>wiki.qaq.ellekit-panel.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>@PREFIX@/usr/libexec/ellekit-panel/ekpaneld</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>UserName</key>
    <string>root</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>@PREFIX@/var/log/ellekit-panel.log</string>
    <key>StandardErrorPath</key>
    <string>@PREFIX@/var/log/ellekit-panel.log</string>
</dict>
</plist>
