#!/bin/sh
# ellekit-panel: start the helper and register the app.
set -e

/bin/launchctl bootout system @PREFIX@/Library/LaunchDaemons/wiki.qaq.ellekit-panel.daemon.plist 2>/dev/null || true
/bin/launchctl bootstrap system @PREFIX@/Library/LaunchDaemons/wiki.qaq.ellekit-panel.daemon.plist 2>/dev/null || true

if [ -x @PREFIX@/usr/bin/uicache ]; then
    @PREFIX@/usr/bin/uicache -p @PREFIX@/Applications/ElleKitPanel.app >/dev/null 2>&1 || true
fi

exit 0
